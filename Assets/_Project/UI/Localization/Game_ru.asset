      m_Items: []
  - m_Id: 12019818521
    m_Localized: "{0:0} \u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 12019818522
    m_Localized: "\u041E\u0422\u041F\u0420\u0410\u0412\u041A\u0410 \u0412\u041E\u0419\u0421\u041A"
    m_Metadata:
      m_Items: []
  - m_Id: 12019818523
    m_Localized: "\u041A\u0430\u0436\u0434\u0430\u044F \u043E\u0442\u043F\u0440\u0430\u0432\u043A\u0430 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0434\u043E\u043C\u0430 \u043D\u0435 \u043C\u0435\u043D\u0435\u0435 20% \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u0445 \u0432\u043E\u0439\u0441\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 12019818524
    m_Localized: "\u0412\u043E\u0439\u0441\u043A\u0430 {0}% / \u0420\u0430\u0431\u043E\u0447\u0438\u0435 {1}%"
    m_Metadata:
      m_Items: []
  - m_Id: 12019818525
    m_Localized: "\u0410\u041A\u0422\u0418\u0412\u041D\u042B\u0415 \u041E\u041F\u0415\u0420\u0410\u0426\u0418\u0418"
    m_Metadata:
      m_Items: []
  - m_Id: 12019818526
    m_Localized: "\u0410\u043A\u0442\u0438\u0432\u043D\u044B\u0445 \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u0439 \u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 12019818527
    m_Localized: "\u041B\u041A\u041C: \u044D\u043A\u0441\u043F\u0430\u043D\u0441\u0438\u044F / \u0430\u0442\u0430\u043A\u0430 \xB7 \u041F\u041A\u041C: \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \xB7 \u0417\u0430\u0436\u0430\u0442\u0430\u044F \u041B\u041A\u041C / WASD: \u043A\u0430\u043C\u0435\u0440\u0430 \xB7 \u041A\u043E\u043B\u0435\u0441\u043E: \u043C\u0430\u0441\u0448\u0442\u0430\u0431 \xB7 Q / E: \u0434\u043E\u043B\u044F \u0430\u0442\u0430\u043A\u0438 \xB7 Space: \u0440\u0435\u043B\u044C\u0435\u0444"
    m_Metadata:
      m_Items: []
  - m_Id: 12019818528
    m_Localized: "\u041D\u0430\u0441\u0435\u043B\u0435\u043D\u0438\u0435  {0:N0} / {1:N0}"
    m_Metadata:
      m_Items: []
  - m_Id: 12019818529
    m_Localized: "\u041F\u0440\u0438\u0440\u043E\u0441\u0442  +{0:N0} / \u0441"
