      m_Items: []
  - m_Id: 12019818507
    m_Localized: "\u041F\u043E\u0431\u0435\u0434\u0430: \u0437\u0430\u0445\u0432\u0430\u0442\u0438 {0}% \u0441\u0443\u0448\u0438 \u043C\u0438\u0440\u0430"
