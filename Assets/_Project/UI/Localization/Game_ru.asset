    m_Metadata:
      m_Items: []
  - m_Id: 12019818544
    m_Localized: "\u0412\u0440\u0435\u043C\u044F: {0:00}:{1:00}\n\u041F\u0438\u043A \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438: {2:F2}%\n\u0417\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043E \u0437\u043E\u043B\u043E\u0442\u0430: {3:N0}"
    m_Metadata:
      m_Items: []
  - m_Id: 12019818545
    m_Localized: "\u0421\u044B\u0433\u0440\u0430\u0442\u044C \u0441\u043D\u043E\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 12019818546
    m_Localized: "\u0422\u043E\u0447\u043A\u0430 \u0441\u0442\u0430\u0440\u0442\u0430 \u0432\u044B\u0431\u0440\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 12019818547
    m_Localized: "\u041C\u0430\u0442\u0447 \u043D\u0430\u0447\u0430\u043B\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 12019818548
    m_Localized: "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E. \u041F\u0440\u043E\u0432\u0435\u0440\u044C \u043E\u0431\u0449\u0443\u044E \u0433\u0440\u0430\u043D\u0438\u0446\u0443 \u0438 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u0435 \u0432\u043E\u0439\u0441\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 12019818549
    m_Localized: "\u0412\u043E\u0439\u0441\u043A\u0430 \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 12019818550
    m_Localized: "\u041F\u043E\u0434\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435 \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043E."
