    m_Localized: "\u041A\u0430\u0437\u043D\u0430  {0:N0}  (+{1:N0} / \u0441)"
    m_Metadata:
      m_Items: []
  - m_Id: 12019818531
    m_Localized: "\u0414\u043E\u043C\u0430 {0:N0} \xB7 \u041E\u0442\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043E {1:N0} \xB7 \u0412\u043E\u0437\u0432\u0440\u0430\u0442 {2:N0}"
    m_Metadata:
      m_Items: []
  - m_Id: 12019818532
    m_Localized: "\u041B\u0438\u0434\u0435\u0440: {0}  \xB7  {1:F2}%"
    m_Metadata:
      m_Items: []
  - m_Id: 12019818533
    m_Localized: "\u0422\u0432\u043E\u044F \u0441\u0443\u0448\u0430: {0:F2}%  \xB7  \u0414\u043B\u044F \u043F\u043E\u0431\u0435\u0434\u044B: {1:0}%"
    m_Metadata:
      m_Items: []
  - m_Id: 12019818534
