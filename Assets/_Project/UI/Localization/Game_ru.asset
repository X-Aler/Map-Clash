    m_Localized: "\u0412\u044B\u0436\u0438\u0432\u0448\u0438\u0435 \u0432\u043E\u0439\u0441\u043A\u0430 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044E\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 12019818552
    m_Localized: "\u0421\u0442\u0440\u0430\u043D\u0430 \u0430\u043D\u043D\u0435\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u0430."
