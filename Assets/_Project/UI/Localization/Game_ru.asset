      m_Items: []
  - m_Id: 12019818500
    m_Localized: "\u041A\u0410\u0420\u0422\u0410 \u041C\u0418\u0420\u0410 \xB7 \u041E\u0414\u0418\u041D\u041E\u0427\u041D\u0410\u042F \u0418\u0413\u0420\u0410"
