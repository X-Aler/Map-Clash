:root {
    --panel: rgba(18, 20, 24, 0.94);
    --muted: rgb(158, 175, 184);
    --accent: rgb(103, 222, 192);
    --line: rgba(166, 195, 205, 0.22);
    color: rgb(235, 242, 244);
    font-size: 17px;
}

.screen {
    flex-grow: 1;
}

.hidden {
    display: none;
}

.panel {
    background-color: var(--panel);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 12px;
    padding: 20px;
}

.row {
    flex-direction: row;
    align-items: center;
}

.spread {
    justify-content: space-between;
}

.grow {
    flex-grow: 1;
}

.muted {
    color: var(--muted);
    white-space: normal;
    font-size: 14px;
}

.eyebrow {
    color: var(--accent);
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin-bottom: 10px;
}

.brand {
    font-size: 64px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin-left: -4px;
    margin-bottom: 4px;
}

.heading {
    font-size: 26px;
    -unity-font-style: bold;
    margin-bottom: 16px;
}

.section-heading {
    font-size: 15px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

Button {
    color: rgb(235, 242, 244);
    background-color: rgb(36, 46, 53);
    border-width: 1px;
    border-color: rgb(67, 85, 94);
    border-radius: 7px;
    padding: 10px 16px;
    margin: 4px;
    min-height: 40px;
    -unity-text-align: middle-center;
}

Button:hover {
    background-color: rgb(51, 73, 78);
    border-color: var(--accent);
}

Button:active {
    background-color: rgb(29, 95, 82);
}

Button:disabled {
    color: rgb(113, 128, 133);
    background-color: rgb(28, 34, 39);
}

.primary {
    color: rgb(12, 32, 29);
    background-color: var(--accent);
    border-color: var(--accent);
    -unity-font-style: bold;
}

.primary:hover {
    color: rgb(10, 30, 27);
    background-color: rgb(137, 239, 212);
}

.selected {
    border-color: var(--accent);
    color: var(--accent);
    background-color: rgb(29, 68, 62);
}

.modal-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(6, 15, 21, 0.65);
    justify-content: center;
    align-items: center;
}

.menu-card {
    width: 610px;
    max-height: 95%;
    padding: 32px;
}

.compact-card {
    width: 520px;
    padding: 32px;
}

.menu-brand-row {
    justify-content: space-between;
    align-items: flex-start;
}

.language-button {
    min-height: 34px;
    padding: 6px 9px;
    font-size: 13px;
}

.menu-description {
    margin-bottom: 20px;
}

.form-field {
    margin-bottom: 12px;
}

.field-label {
    font-size: 14px;
    color: var(--muted);
    margin-bottom: 5px;
}

.unity-base-field {
    flex-direction: row;
    align-items: center;
    margin: 2px 0;
    min-height: 32px;
}

.unity-base-field__label {
    color: var(--muted);
    min-width: 120px;
    flex-shrink: 0;
    -unity-text-align: middle-left;
    white-space: normal;
}

.unity-base-field--no-label > .unity-base-field__label {
    display: none;
}

.unity-base-field__input {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.unity-base-text-field__input,
.unity-base-popup-field__input {
    min-height: 34px;
    background-color: rgb(25, 35, 42);
    color: rgb(239, 246, 246);
    border-width: 1px;
    border-color: rgb(62, 80, 88);
    border-radius: 6px;
    padding: 8px;
    -unity-text-align: middle-left;
}

.unity-base-text-field__input:focus {
    border-color: var(--accent);
}

.unity-base-slider {
    min-height: 34px;
}

.unity-base-slider__input {
    position: relative;
    height: 32px;
    min-width: 60px;
    margin: 0 8px;
}

.unity-base-slider__tracker {
    position: absolute;
    left: 0;
    right: 0;
    top: 14px;
    background-color: rgb(57, 77, 83);
    height: 4px;
    border-radius: 2px;
}

.unity-base-slider__dragger {
    position: absolute;
    left: 0;
    top: 8px;
    background-color: var(--accent);
    border-color: var(--accent);
    border-width: 1px;
    border-radius: 8px;
    width: 15px;
    height: 15px;
}

.unity-base-slider__dragger-border {
    display: none;
}

.unity-base-slider__text-field {
    width: 62px;
    flex-grow: 0;
    margin-left: 8px;
}

.unity-toggle > .unity-base-field__label {
    min-width: 0;
    flex-grow: 1;
}

.unity-toggle__input {
    flex-direction: row;
    flex-grow: 0;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    min-height: 30px;
    margin-left: 10px;
}

.unity-toggle__checkmark {
    width: 18px;
    height: 18px;
    border-width: 1px;
    border-color: rgb(98, 125, 133);
    border-radius: 4px;
    background-color: rgb(25, 35, 42);
}

.unity-toggle:checked .unity-toggle__checkmark,
.unity-toggle__input:checked > .unity-toggle__checkmark {
    background-color: var(--accent);
    border-color: var(--accent);
}

.unity-toggle__text {
    margin-left: 8px;
    white-space: normal;
}

.unity-scroll-view {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.unity-scroll-view__content-and-vertical-scroll-container {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.unity-scroll-view__content-viewport {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.unity-scroll-view__content-container {
    flex-grow: 0;
}

.unity-scroll-view__vertical-scroller {
    width: 12px;
    margin-left: 4px;
}

.unity-scroller--vertical {
    flex-direction: column;
}

.unity-scroller__slider {
    flex-grow: 1;
}

.unity-scroller__low-button,
.unity-scroller__high-button {
    display: none;
}

.unity-base-slider--vertical > .unity-base-slider__input {
    width: 12px;
    height: auto;
    min-width: 0;
    flex-grow: 1;
    margin: 0;
}

.unity-base-slider--vertical .unity-base-slider__tracker {
    left: 4px;
    right: auto;
    top: 0;
    bottom: 0;
    width: 4px;
    height: auto;
}

.unity-base-slider--vertical .unity-base-slider__dragger {
    left: 0;
    top: 0;
    width: 12px;
    min-height: 18px;
}

.start-button {
    margin-top: 18px;
    min-height: 52px;
    font-size: 19px;
}

.hud-top {
    position: absolute;
    left: 24px;
    right: 24px;
    top: 20px;
    align-items: flex-start;
}

.leader-panel {
    flex-grow: 1;
    max-width: 650px;
    padding: 12px 18px;
    margin-right: 12px;
}

.leader-name {
    font-size: 17px;
    -unity-font-style: bold;
    margin-bottom: 7px;
}

.match-clock {
    font-size: 23px;
    -unity-font-style: bold;
    margin-right: 12px;
}

.clock-panel {
    padding: 8px 14px;
}

.progress .unity-progress-bar__container {
    position: relative;
    overflow: hidden;
    height: 8px;
    border-width: 0;
    background-color: rgb(48, 61, 65);
}

.progress .unity-progress-bar__progress {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background-color: var(--accent);
}

.progress .unity-progress-bar__title {
    display: none;
}

.victory-marker {
    position: absolute;
    left: 0;
    top: 0;
    height: 12px;
    width: 2px;
    background-color: rgb(247, 206, 119);
}

.state-indicator {
    font-size: 12px;
    color: var(--accent);
    margin-bottom: 5px;
}

.at-war {
    color: rgb(248, 139, 128);
}

.spawn-panel {
    position: absolute;
    top: 130px;
    align-self: center;
    max-width: 640px;
    align-items: center;
}

.spawn-countdown {
    font-size: 34px;
    color: var(--accent);
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.hud-bottom {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 22px;
    flex-direction: row;
    align-items: stretch;
}

.country-panel {
    min-width: 325px;
    flex-grow: 1;
    margin-right: 12px;
}

.country-name {
    font-size: 24px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.stat {
    margin-bottom: 5px;
    font-size: 16px;
}

.gold {
    color: rgb(247, 206, 119);
}

.positive {
    color: var(--accent);
}

.attack-panel {
    min-width: 410px;
    flex-grow: 1;
    margin-right: 12px;
}

.preset {
    flex-grow: 1;
    padding: 6px 8px;
    min-height: 34px;
    font-size: 14px;
}

.attack-slider {
    flex-grow: 1;
    margin-right: 8px;
}

.ratio-input {
    width: 70px;
}

.operations-panel {
    width: 325px;
}

.operations-list {
    max-height: 130px;
}

.operation-row {
    margin-bottom: 3px;
}

.operation-text {
    font-size: 13px;
    flex-grow: 1;
    white-space: normal;
}

.recall {
    padding: 4px 10px;
    min-height: 30px;
    font-size: 13px;
}

.map-help {
    position: absolute;
    bottom: 245px;
    align-self: center;
    color: rgb(193, 209, 216);
    font-size: 13px;
    background-color: rgba(11, 23, 30, 0.8);
    border-radius: 5px;
    padding: 7px 12px;
}

.notification {
    position: absolute;
    right: 24px;
    top: 116px;
    width: 330px;
    color: rgb(247, 206, 119);
    white-space: normal;
    font-size: 14px;
    padding: 12px 16px;
}

.context-wheel {
    position: absolute;
    left: 0;
    top: 0;
    width: 260px;
    height: 170px;
    justify-content: center;
    align-items: center;
    padding: 10px;
    border-radius: 55px;
}

.context-title {
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}

.result-stats {
    margin: 12px 0 18px 0;
    white-space: normal;
    font-size: 18px;
}
